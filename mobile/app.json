{
  "expo": {
    "name": "Atlas One",
    "slug": "atlas-office",
    "version": "0.1.5",
    "orientation": "portrait",
    "scheme": "atlasoffice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/atlas-one-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "il.co.atlas.office",
      "icon": "./assets/atlas-one-app-icon.png"
    },
    "android": {
      "package": "il.co.atlas.office",
      "adaptiveIcon": {
        "foregroundImage": "./assets/atlas-one-app-icon.png",
        "backgroundColor": "#FF5A1F"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите Atlas One использовать камеру для сканирования QR-кодов билетов.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiBaseUrl": "https://www.atlas-one.co",
      "eas": {
        "projectId": "b3d8cabf-2459-4509-ae6f-4b06b2bbdd88"
      }
    }
  }
}
