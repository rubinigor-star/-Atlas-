{
  "expo": {
    "name": "Atlas Office",
    "slug": "atlas-office",
    "version": "0.1.2",
    "orientation": "portrait",
    "scheme": "atlasoffice",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "il.co.atlas.office"
    },
    "android": {
      "package": "il.co.atlas.office",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите Atlas Office использовать камеру для сканирования QR-кодов билетов.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://www.atlas-one.co"
    }
  }
}
